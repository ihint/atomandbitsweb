{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "claims-native-www-redirect",
  "main": "src/index.mjs",
  "compatibility_date": "2026-08-24",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "www.claimsnative.com/*",
      "zone_name": "claimsnative.com"
    }
  ]
}
