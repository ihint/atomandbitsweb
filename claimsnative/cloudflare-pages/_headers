/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'none'; img-src 'self' data:; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self' https://us.i.posthog.com https://eu.i.posthog.com https://cloudflareinsights.com

/site.css
  Cache-Control: public, max-age=3600

/home.css
  Cache-Control: public, max-age=3600

/calculator.js
  Cache-Control: public, max-age=3600

/og.png
  Cache-Control: public, max-age=86400

/growth.js
  Cache-Control: public, max-age=3600
/growth-config.js
  Cache-Control: no-cache

https://claimsnative.pages.dev/*
  X-Robots-Tag: noindex, nofollow

https://:branch.claimsnative.pages.dev/*
  X-Robots-Tag: noindex, nofollow
