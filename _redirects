# Cloudflare applies these before serving a page. Each moved URL keeps
# working with a permanent redirect. Specific rules come before splats.

# Old Claims Native URLs. Destinations checked live on 2026-10-26.
# billing-setup was the readiness page (EHR handoff, enrollment, approval).
# how-we-start is the live sequence for that setup. keep-your-ehr has no
# successor page; the homepage states that the EHR stays the record.
# remittance-and-deposits matches the deposit-vs-ERA guide.
# 90-day-pilot and independent-practices already 301 on claimsnative.com;
# these rules skip that second hop. cloudflare-pages was a repo artifact.
/claimsnative/billing-setup https://claimsnative.com/how-we-start/ 301
/claimsnative/billing-setup/* https://claimsnative.com/how-we-start/ 301
/claimsnative/keep-your-ehr https://claimsnative.com/ 301
/claimsnative/keep-your-ehr/* https://claimsnative.com/ 301
/claimsnative/remittance-and-deposits https://claimsnative.com/learn/match-insurance-deposits/ 301
/claimsnative/remittance-and-deposits/* https://claimsnative.com/learn/match-insurance-deposits/ 301
/claimsnative/90-day-pilot https://claimsnative.com/how-we-start/ 301
/claimsnative/90-day-pilot/* https://claimsnative.com/how-we-start/ 301
/claimsnative/independent-practices https://claimsnative.com/ 301
/claimsnative/independent-practices/* https://claimsnative.com/ 301
/claimsnative/cloudflare-pages/robots.txt https://claimsnative.com/robots.txt 301
/claimsnative/cloudflare-pages/sitemap.xml https://claimsnative.com/sitemap.xml 301
/claimsnative/cloudflare-pages https://claimsnative.com/ 301
/claimsnative/cloudflare-pages/* https://claimsnative.com/ 301

# Claims Native lives on its own domain.
/claimsnative https://claimsnative.com/ 301
/claimsnative/* https://claimsnative.com/:splat 301

# Corridor Robotics lives on its own domain.
/corridor https://corridorrobotics.com/ 301
/corridor/ https://corridorrobotics.com/ 301
/corridor/* https://corridorrobotics.com/ 301

