// atomandbits.com on Cloudflare Workers. The repository root is the site;
// .assetsignore keeps everything that is not a page or asset off the web.
// Run locally with `wrangler dev`; deploy with `wrangler deploy`.
{
  "name": "atomandbits-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Contact form mail. The sender must be on a domain onboarded to Cloudflare
  // Email Service; every message goes only to Ian.
  "send_email": [{ "name": "EMAIL", "destination_address": "Ian@atomandbits.com" }],
  "vars": { "CONTACT_TO": "Ian@atomandbits.com", "CONTACT_FROM": "website@atomandbits.com" },
  "workers_dev": true,
  "observability": { "enabled": true }
}
