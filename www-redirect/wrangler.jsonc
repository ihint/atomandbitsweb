// Sends www.atomandbits.com to atomandbits.com. A separate Worker keeps the
// site Worker off every request, so Cloudflare still applies _redirects there.
// Deploy with `wrangler deploy --config www-redirect/wrangler.jsonc`.
{
  "name": "atomandbits-www-redirect",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "www.atomandbits.com", "custom_domain": true }]
}
